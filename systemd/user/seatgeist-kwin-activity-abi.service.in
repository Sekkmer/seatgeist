[Unit]
Description=Check Seatgeist KWin plugin compatibility and session readiness
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=@WATCHER@ --runtime
# Three DBus probes and normally one compact CLI probe (2s each), plus a
# compatibility CLI fallback and notification margin. An absent daemon uses
# one systemd unit-state query instead of CLI probes to recognize socket standby.
TimeoutStartSec=16s
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
