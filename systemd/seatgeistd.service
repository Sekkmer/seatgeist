[Unit]
Description=Seatgeist desktop-control daemon
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
ExecStart=%h/.local/bin/seatgeistd --socket %t/seatgeist/seatgeistd.sock
Restart=on-failure
RestartSec=2s
RestartSteps=4
RestartMaxDelaySec=30s
TimeoutStopSec=5s
NoNewPrivileges=true
Environment=MALLOC_ARENA_MAX=4

[Install]
WantedBy=graphical-session.target
