{
  "version": 1,
  "description": "Safe status-only replay trace for verifying a PlasmaPilot daemon without control side effects.",
  "steps": [
    {
      "label": "health",
      "request": {
        "method": "health"
      },
      "expect_response_type": "health",
      "expect_ok": true
    },
    {
      "label": "capabilities",
      "request": {
        "method": "capabilities"
      },
      "expect_response_type": "capabilities",
      "expect_ok": true
    },
    {
      "label": "policy",
      "request": {
        "method": "policy_status"
      },
      "expect_response_type": "policy_status",
      "expect_ok": true
    },
    {
      "label": "safety",
      "request": {
        "method": "safety_status"
      },
      "expect_response_type": "safety_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/journal_artifact_metadata_enabled",
          "equals": false
        }
      ]
    },
    {
      "label": "desktop-session",
      "request": {
        "method": "desktop_session_status"
      },
      "expect_response_type": "desktop_session_status",
      "expect_ok": true
    },
    {
      "label": "kwin-bridge-status",
      "request": {
        "method": "kwin_bridge_status"
      },
      "expect_response_type": "kwin_bridge_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/dbus_service_registered",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/active_window_update_seen",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/package_installed",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/script_enabled",
          "exists": true
        }
      ]
    },
    {
      "label": "uinput-status",
      "request": {
        "method": "uinput_status"
      },
      "expect_response_type": "uinput_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/available",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/setup_hint",
          "value_type": "string"
        }
      ]
    },
    {
      "label": "capture-backend-status",
      "request": {
        "method": "capture_backend_status"
      },
      "expect_response_type": "capture_backend_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/screenshot_portal/setup_hint",
          "value_type": "string"
        },
        {
          "pointer": "/data/kwin_metadata/setup_hint",
          "value_type": "string"
        },
        {
          "pointer": "/data/spectacle/setup_hint",
          "value_type": "string"
        },
        {
          "pointer": "/data/setup_hint",
          "value_type": "string"
        }
      ]
    },
    {
      "label": "clipboard-backend-status",
      "request": {
        "method": "clipboard_backend_status"
      },
      "expect_response_type": "clipboard_backend_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/wl_paste_available",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/wl_copy_available",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/kde_klipper_available",
          "value_type": "boolean"
        },
        {
          "pointer": "/data/setup_hint",
          "value_type": "string"
        }
      ]
    },
    {
      "label": "input-backend-keymap-status",
      "request": {
        "method": "input_backend_status"
      },
      "expect_response_type": "input_backend_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/configured_backend",
          "equals": "auto"
        },
        {
          "pointer": "/data/eis_keymap/source",
          "value_type": "string"
        },
        {
          "pointer": "/data/eis_keymap/setup_hint",
          "value_type": "string"
        }
      ]
    },
    {
      "label": "remote-desktop-eis-session-status-inactive",
      "request": {
        "method": "remote_desktop_eis_session_status"
      },
      "expect_response_type": "remote_desktop_eis_session_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/active",
          "equals": false
        }
      ]
    },
    {
      "label": "remote-desktop-eis-stop-inactive",
      "request": {
        "method": "remote_desktop_eis_stop"
      },
      "expect_response_type": "remote_desktop_eis_session_status",
      "expect_ok": true,
      "expect_json": [
        {
          "pointer": "/data/active",
          "equals": false
        }
      ]
    }
  ]
}
