{
  "version": 1,
  "description": "Safe deny-by-default replay trace for verifying protected actions fail closed before backend side effects.",
  "steps": [
    {
      "label": "full-resolution-screenshot-denied",
      "request": {
        "method": "screenshot",
        "output": "/tmp/plasma-pilot-denied-full-resolution.png",
        "max_edge": null,
        "full_resolution": true
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for FullResolutionScreenshot",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "clipboard-read-denied",
      "request": {
        "method": "clipboard_get",
        "max_bytes": 64
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ClipboardRead",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "focus-window-denied",
      "request": {
        "method": "focus_window",
        "window_id": "plasma-pilot-nonexistent-window"
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlSemantic",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "accessibility-set-caret-denied",
      "request": {
        "method": "accessibility_set_caret",
        "node_id": "atspi://:1.42/org/a11y/atspi/accessible/7",
        "offset": 0
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlSemantic",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "accessibility-set-selection-denied",
      "request": {
        "method": "accessibility_set_selection",
        "node_id": "atspi://:1.42/org/a11y/atspi/accessible/7",
        "selection_num": 0,
        "start_offset": 0,
        "end_offset": 1
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlSemantic",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    }
  ]
}
