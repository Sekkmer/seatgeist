{
  "version": 1,
  "description": "Safe deny-by-default replay trace for verifying raw keyboard, pointer, and RemoteDesktop input probes fail closed before backend side effects.",
  "steps": [
    {
      "label": "type-text-denied",
      "request": {
        "method": "type_text",
        "text": "seatgeist-should-not-type"
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlKeyboard",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "key-combo-denied",
      "request": {
        "method": "key_combo",
        "combo": "Ctrl+L"
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlKeyboard",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "move-pointer-denied",
      "request": {
        "method": "move_pointer",
        "point": {
          "x": 10.0,
          "y": 10.0,
          "space": "physical_pixel"
        }
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "click-pointer-denied",
      "request": {
        "method": "click_pointer",
        "point": {
          "x": 10.0,
          "y": 10.0,
          "space": "physical_pixel"
        },
        "button": "left",
        "clicks": 1
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "drag-pointer-denied",
      "request": {
        "method": "drag_pointer",
        "from": {
          "x": 10.0,
          "y": 10.0,
          "space": "physical_pixel"
        },
        "to": {
          "x": 20.0,
          "y": 20.0,
          "space": "physical_pixel"
        },
        "button": "left",
        "duration_ms": 50
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "scroll-pointer-denied",
      "request": {
        "method": "scroll_pointer",
        "vertical": -1,
        "horizontal": 0
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "remote-desktop-session-probe-denied",
      "request": {
        "method": "remote_desktop_session_probe",
        "keyboard": true,
        "pointer": true,
        "touchscreen": false,
        "timeout_ms": 1000
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "remote-desktop-eis-probe-denied",
      "request": {
        "method": "remote_desktop_eis_probe",
        "keyboard": true,
        "pointer": true,
        "touchscreen": false,
        "timeout_ms": 1000
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    },
    {
      "label": "remote-desktop-eis-start-denied",
      "request": {
        "method": "remote_desktop_eis_start",
        "keyboard": true,
        "pointer": true,
        "touchscreen": false,
        "timeout_ms": 1000
      },
      "expect_response_type": "error",
      "expect_ok": false,
      "expect_error_contains": "policy prompt required for ControlPointer",
      "expect_json": [
        {
          "pointer": "/data/kind",
          "equals": "policy_prompt_required"
        }
      ]
    }
  ]
}
